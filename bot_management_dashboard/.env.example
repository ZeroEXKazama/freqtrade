DASHBOARD_APP_ENV=development
DASHBOARD_DATABASE_URL=sqlite:///./bot_dashboard.db
DASHBOARD_JWT_SECRET=replace-with-long-random-jwt-secret
DASHBOARD_ENCRYPTION_KEY=replace-with-fernet-key
DASHBOARD_JWT_EXP_MINUTES=60
DASHBOARD_NONCE_TTL_SECONDS=300
DASHBOARD_AUTH_RATE_LIMIT=30
DASHBOARD_AUTH_RATE_WINDOW_SECONDS=60
DASHBOARD_ALLOWED_DOMAIN=your-dashboard-domain.com
# Optional if frontend is deployed separately:
# DASHBOARD_CORS_ORIGINS=https://your-frontend.railway.app

